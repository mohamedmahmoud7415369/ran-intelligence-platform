version: "3.9"

networks:
  ran-network:
    driver: overlay
    attachable: true

x-restart: &restart
  restart_policy:
    condition: on-failure
    delay: 10s

x-kafka-common: &kafka-common
  image: apache/kafka:3.9.2
  command: ["/opt/kafka/bin/kafka-server-start.sh", "/mnt/shared/config/server.properties"]
  environment:
    KAFKA_HEAP_OPTS: "-Xms512m -Xmx1024m"
  networks: [ran-network]
  healthcheck:
    test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 >/dev/null 2>&1 || exit 1"]
    interval: 30s
    timeout: 10s
    retries: 8
    start_period: 60s

x-spark-master-common: &spark-master-common
  image: apache/spark:3.5.8
  environment:
    SPARK_DAEMON_MEMORY: "512m"
    SPARK_DAEMON_JAVA_OPTS: >-
      -Dspark.deploy.recoveryMode=ZOOKEEPER
      -Dspark.deploy.zookeeper.url=zookeeper1:2181,zookeeper2:2181,zookeeper3:2181
      -Dspark.deploy.zookeeper.dir=/spark-ha
  networks: [ran-network]

x-spark-worker-common: &spark-worker-common
  image: apache/spark:3.5.8
  environment:
    SPARK_DAEMON_MEMORY: "512m"
    SPARK_WORKER_MEMORY: "2g"
    SPARK_WORKER_CORES: "2"
  networks: [ran-network]

x-hadoop-common: &hadoop-common
  image: apache/hadoop:3.5.0
  user: "0"
  entrypoint: ["/usr/local/bin/dumb-init", "--"]
  environment:
    HADOOP_CONF_DIR: /opt/hadoop/etc/hadoop
  configs:
    - source: hadoop_core_site
      target: /opt/hadoop/etc/hadoop/core-site.xml
    - source: hadoop_hdfs_site
      target: /opt/hadoop/etc/hadoop/hdfs-site.xml
  networks: [ran-network]

# Added: two-worker Kafka Connect distributed cluster.
x-connect-env: &connect-env
  CONNECT_BOOTSTRAP_SERVERS: kafka1:9092,kafka2:9092,kafka3:9092
  CONNECT_GROUP_ID: ran-connect-cluster
  CONNECT_CONFIG_STORAGE_TOPIC: ran-connect-configs
  CONNECT_CONFIG_STORAGE_REPLICATION_FACTOR: "3"
  CONNECT_OFFSET_STORAGE_TOPIC: ran-connect-offsets
  CONNECT_OFFSET_STORAGE_REPLICATION_FACTOR: "3"
  CONNECT_OFFSET_STORAGE_PARTITIONS: "25"
  CONNECT_STATUS_STORAGE_TOPIC: ran-connect-status
  CONNECT_STATUS_STORAGE_REPLICATION_FACTOR: "3"
  CONNECT_STATUS_STORAGE_PARTITIONS: "5"
  CONNECT_KEY_CONVERTER: org.apache.kafka.connect.storage.StringConverter
  CONNECT_VALUE_CONVERTER: org.apache.kafka.connect.json.JsonConverter
  CONNECT_VALUE_CONVERTER_SCHEMAS_ENABLE: "false"
  CONNECT_INTERNAL_KEY_CONVERTER: org.apache.kafka.connect.json.JsonConverter
  CONNECT_INTERNAL_VALUE_CONVERTER: org.apache.kafka.connect.json.JsonConverter
  CONNECT_INTERNAL_KEY_CONVERTER_SCHEMAS_ENABLE: "false"
  CONNECT_INTERNAL_VALUE_CONVERTER_SCHEMAS_ENABLE: "false"
  CONNECT_PLUGIN_PATH: /usr/share/java,/usr/share/confluent-hub-components
  CONNECT_OFFSET_FLUSH_INTERVAL_MS: "10000"
  CONNECT_PRODUCER_ACKS: all
  CONNECT_CONFLUENT_SUPPORT_METRICS_ENABLE: "false"
  CONNECT_LOG4J_ROOT_LOGLEVEL: INFO
  KAFKA_HEAP_OPTS: -Xms512m -Xmx1024m

x-connect-common: &connect-common
  image: ran-kafka-connect-hdfs3:3.0.12
  configs:
    - source: hadoop_core_site
      target: /etc/hadoop/core-site.xml
    - source: hadoop_hdfs_site
      target: /etc/hadoop/hdfs-site.xml
  networks: [ran-network]
  healthcheck:
    test: ["CMD-SHELL", "curl -fsS http://localhost:8083/connectors >/dev/null || exit 1"]
    interval: 30s
    timeout: 10s
    retries: 12
    start_period: 120s

services:
  # ---------------- ZOOKEEPER 3/3 ----------------
  zookeeper1:
    image: zookeeper:3.8.5
    hostname: zookeeper1
    environment:
      ZOO_MY_ID: "1"
      ZOO_SERVERS: "server.1=zookeeper1:2888:3888;2181 server.2=zookeeper2:2888:3888;2181 server.3=zookeeper3:2888:3888;2181"
      ZOO_4LW_COMMANDS_WHITELIST: "ruok,srvr,stat,mntr"
    volumes: [zookeeper1-data:/data, zookeeper1-log:/datalog]
    networks: [ran-network]
    healthcheck:
      test: ["CMD-SHELL", "zkServer.sh status >/dev/null 2>&1 || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 6
      start_period: 30s
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "0.50", memory: 512M}
      <<: *restart

  zookeeper2:
    image: zookeeper:3.8.5
    hostname: zookeeper2
    environment:
      ZOO_MY_ID: "2"
      ZOO_SERVERS: "server.1=zookeeper1:2888:3888;2181 server.2=zookeeper2:2888:3888;2181 server.3=zookeeper3:2888:3888;2181"
      ZOO_4LW_COMMANDS_WHITELIST: "ruok,srvr,stat,mntr"
    volumes: [zookeeper2-data:/data, zookeeper2-log:/datalog]
    networks: [ran-network]
    healthcheck:
      test: ["CMD-SHELL", "zkServer.sh status >/dev/null 2>&1 || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 6
      start_period: 30s
    deploy:
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "0.50", memory: 512M}
      <<: *restart

  zookeeper3:
    image: zookeeper:3.8.5
    hostname: zookeeper3
    environment:
      ZOO_MY_ID: "3"
      ZOO_SERVERS: "server.1=zookeeper1:2888:3888;2181 server.2=zookeeper2:2888:3888;2181 server.3=zookeeper3:2888:3888;2181"
      ZOO_4LW_COMMANDS_WHITELIST: "ruok,srvr,stat,mntr"
    volumes: [zookeeper3-data:/data, zookeeper3-log:/datalog]
    networks: [ran-network]
    healthcheck:
      test: ["CMD-SHELL", "zkServer.sh status >/dev/null 2>&1 || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 6
      start_period: 30s
    deploy:
      placement:
        constraints: ["node.labels.node_id == 3"]
      resources:
        limits: {cpus: "0.40", memory: 384M}
      <<: *restart

  # ---------------- KAFKA 3/3, ZooKeeper mode ----------------
  kafka1:
    <<: *kafka-common
    hostname: kafka1
    configs:
      - source: kafka1_config
        target: /mnt/shared/config/server.properties
    volumes: [kafka1-data:/var/lib/kafka/data]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "2.00", memory: 2G}
      <<: *restart

  kafka2:
    <<: *kafka-common
    hostname: kafka2
    configs:
      - source: kafka2_config
        target: /mnt/shared/config/server.properties
    volumes: [kafka2-data:/var/lib/kafka/data]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "1.75", memory: 1536M}
      <<: *restart

  kafka3:
    <<: *kafka-common
    hostname: kafka3
    environment:
      KAFKA_HEAP_OPTS: "-Xms256m -Xmx512m"
    configs:
      - source: kafka3_config
        target: /mnt/shared/config/server.properties
    volumes: [kafka3-data:/var/lib/kafka/data]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 3"]
      resources:
        limits: {cpus: "1.25", memory: 1G}
      <<: *restart

  # ---------------- SPARK: 2 HA masters + 3 workers ----------------
  spark-master1:
    <<: *spark-master-common
    hostname: spark-master1
    command: ["/opt/spark/bin/spark-class", "org.apache.spark.deploy.master.Master", "--host", "spark-master1", "--port", "7077", "--webui-port", "8080"]
    ports: ["8080:8080"]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "1.00", memory: 768M}
      <<: *restart

  spark-master2:
    <<: *spark-master-common
    hostname: spark-master2
    command: ["/opt/spark/bin/spark-class", "org.apache.spark.deploy.master.Master", "--host", "spark-master2", "--port", "7077", "--webui-port", "8080"]
    ports: ["8082:8080"]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "0.75", memory: 512M}
      <<: *restart

  spark-worker1:
    <<: *spark-worker-common
    hostname: spark-worker1
    environment:
      SPARK_DAEMON_MEMORY: "384m"
      SPARK_WORKER_MEMORY: "4g"
      SPARK_WORKER_CORES: "4"
    command: ["/opt/spark/bin/spark-class", "org.apache.spark.deploy.worker.Worker", "spark://spark-master1:7077,spark-master2:7077", "--host", "spark-worker1", "--webui-port", "8081"]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "5.00", memory: 5G}
      <<: *restart

  spark-worker2:
    <<: *spark-worker-common
    hostname: spark-worker2
    environment:
      SPARK_DAEMON_MEMORY: "384m"
      SPARK_WORKER_MEMORY: "2g"
      SPARK_WORKER_CORES: "3"
    command: ["/opt/spark/bin/spark-class", "org.apache.spark.deploy.worker.Worker", "spark://spark-master1:7077,spark-master2:7077", "--host", "spark-worker2", "--webui-port", "8081"]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "3.00", memory: 2560M}
      <<: *restart

  spark-worker3:
    <<: *spark-worker-common
    hostname: spark-worker3
    environment:
      SPARK_DAEMON_MEMORY: "256m"
      SPARK_WORKER_MEMORY: "512m"
      SPARK_WORKER_CORES: "1"
    command: ["/opt/spark/bin/spark-class", "org.apache.spark.deploy.worker.Worker", "spark://spark-master1:7077,spark-master2:7077", "--host", "spark-worker3", "--webui-port", "8081"]
    deploy:
      placement:
        # Abdullah has only 4 GB RAM; keep the third worker but place it on Victus.
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "0.75", memory: 768M}
      <<: *restart

  # ---------------- HDFS HA ----------------
  journalnode1:
    <<: *hadoop-common
    hostname: journalnode1
    command: ["/opt/hadoop/bin/hdfs", "journalnode"]
    volumes: [journalnode1-data:/data/journal]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "0.50", memory: 512M}
      <<: *restart

  journalnode2:
    <<: *hadoop-common
    hostname: journalnode2
    command: ["/opt/hadoop/bin/hdfs", "journalnode"]
    volumes: [journalnode2-data:/data/journal]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "0.40", memory: 384M}
      <<: *restart

  journalnode3:
    <<: *hadoop-common
    hostname: journalnode3
    command: ["/opt/hadoop/bin/hdfs", "journalnode"]
    volumes: [journalnode3-data:/data/journal]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 3"]
      resources:
        limits: {cpus: "0.40", memory: 384M}
      <<: *restart

  namenode1:
    <<: *hadoop-common
    hostname: namenode1
    command:
      - bash
      - -lc
      - |
        mkdir -p /data/name
        if [ ! -f /data/name/current/VERSION ]; then
          echo "Formatting primary NameNode..."
          hdfs namenode -Ddfs.ha.namenode.id=nn1 -format -force -nonInteractive
        fi
        exec hdfs namenode -Ddfs.ha.namenode.id=nn1
    volumes: [namenode1-data:/data/name]
    ports: ["9870:9870"]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "2.00", memory: 2G}
      <<: *restart

  namenode2:
    <<: *hadoop-common
    hostname: namenode2
    command:
      - bash
      - -lc
      - |
        mkdir -p /data/name
        if [ ! -f /data/name/current/VERSION ]; then
          echo "Bootstrapping standby NameNode..."
          until hdfs namenode -Ddfs.ha.namenode.id=nn2 -bootstrapStandby -force -nonInteractive; do
            echo "Standby bootstrap not ready; retrying in 10s..."
            sleep 10
          done
        fi
        exec hdfs namenode -Ddfs.ha.namenode.id=nn2
    volumes: [namenode2-data:/data/name]
    ports: ["9871:9870"]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "1.50", memory: 1536M}
      <<: *restart

  zkfc1:
    <<: *hadoop-common
    hostname: namenode1
    command: ["/opt/hadoop/bin/hdfs", "zkfc", "-Ddfs.ha.namenode.id=nn1"]
    deploy:
      replicas: 1
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "0.40", memory: 384M}
      <<: *restart

  zkfc2:
    <<: *hadoop-common
    hostname: namenode2
    command: ["/opt/hadoop/bin/hdfs", "zkfc", "-Ddfs.ha.namenode.id=nn2"]
    deploy:
      replicas: 1
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "0.30", memory: 320M}
      <<: *restart

  datanode1:
    <<: *hadoop-common
    hostname: datanode1
    command: ["/opt/hadoop/bin/hdfs", "datanode"]
    volumes: [datanode1-data:/data/data]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "1.50", memory: 1536M}
      <<: *restart

  datanode2:
    <<: *hadoop-common
    hostname: datanode2
    command: ["/opt/hadoop/bin/hdfs", "datanode"]
    volumes: [datanode2-data:/data/data]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "1.00", memory: 1G}
      <<: *restart

  datanode3:
    <<: *hadoop-common
    hostname: datanode3
    command: ["/opt/hadoop/bin/hdfs", "datanode"]
    volumes: [datanode3-data:/data/data]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 3"]
      resources:
        limits: {cpus: "0.75", memory: 768M}
      <<: *restart

  # ---------------- NEW: ONE-TIME HA/TOPIC INITIALIZERS ----------------
  hdfs-format-zk:
    <<: *hadoop-common
    hostname: namenode1
    command:
      - bash
      - -lc
      - |
        mkdir -p /state
        if [ -f /state/formatted ]; then
          echo "HDFS HA ZooKeeper state already initialized."
          exit 0
        fi
        until hdfs haadmin -getAllServiceState; do sleep 5; done
        hdfs zkfc -Ddfs.ha.namenode.id=nn1 -formatZK -nonInteractive
        touch /state/formatted
    volumes: [hdfs-zkfc-state:/state]
    deploy:
      replicas: 0
      placement:
        constraints: ["node.labels.node_id == 1"]
      restart_policy:
        condition: none

  kafka-init:
    image: apache/kafka:3.9.2
    networks: [ran-network]
    command:
      - bash
      - -lc
      - |
        until /opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server kafka1:9092 >/dev/null 2>&1; do sleep 5; done
        until /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka1:9092 --create --if-not-exists --topic ran-telemetry --partitions 6 --replication-factor 3 --config min.insync.replicas=2; do sleep 5; done
        /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka1:9092 --create --if-not-exists --topic ran-telemetry-dlq --partitions 3 --replication-factor 3 --config min.insync.replicas=2
        /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka1:9092 --describe --topic ran-telemetry
    deploy:
      replicas: 0
      placement:
        constraints: ["node.labels.node_id == 1"]
      restart_policy:
        condition: none

  # ---------------- NEW: KAFKA CONNECT 2-WORKER HA ----------------
  connect1:
    <<: *connect-common
    hostname: connect1
    environment:
      <<: *connect-env
      CONNECT_REST_ADVERTISED_HOST_NAME: connect1
      CONNECT_REST_PORT: "8083"
    ports: ["8083:8083"]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "2.00", memory: 2G}
      <<: *restart

  connect2:
    <<: *connect-common
    hostname: connect2
    environment:
      <<: *connect-env
      CONNECT_REST_ADVERTISED_HOST_NAME: connect2
      CONNECT_REST_PORT: "8083"
      KAFKA_HEAP_OPTS: -Xms512m -Xmx768m
    ports: ["8084:8083"]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "1.50", memory: 1536M}
      <<: *restart

  # ---------------- ANALYTICS / MONITORING ----------------
  clickhouse:
    image: clickhouse/clickhouse-server:25.8
    hostname: clickhouse
    ports: ["8123:8123", "9000:9000"]
    volumes: [clickhouse-data:/var/lib/clickhouse]
    networks: [ran-network]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "4.00", memory: 4G}
      <<: *restart

  grafana:
    image: grafana/grafana:13.0
    hostname: grafana
    ports: ["3000:3000"]
    volumes: [grafana-data:/var/lib/grafana]
    networks: [ran-network]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 1"]
      resources:
        limits: {cpus: "0.75", memory: 768M}
      <<: *restart

  prometheus:
    image: prom/prometheus:v3.13.1
    hostname: prometheus
    command: ["--config.file=/etc/prometheus/prometheus.yml", "--storage.tsdb.path=/prometheus"]
    configs:
      - source: prometheus_config
        target: /etc/prometheus/prometheus.yml
    ports: ["9090:9090"]
    volumes: [prometheus-data:/prometheus]
    networks: [ran-network]
    deploy:
      placement:
        constraints: ["node.labels.node_id == 2"]
      resources:
        limits: {cpus: "0.75", memory: 768M}
      <<: *restart

configs:
  kafka1_config:
    file: ./configs/kafka/kafka1.properties
  kafka2_config:
    file: ./configs/kafka/kafka2.properties
  kafka3_config:
    file: ./configs/kafka/kafka3.properties
  hadoop_core_site:
    file: ./configs/hadoop/core-site.xml
  hadoop_hdfs_site:
    file: ./configs/hadoop/hdfs-site.xml
  prometheus_config:
    file: ./configs/prometheus/prometheus.yml

volumes:
  zookeeper1-data:
  zookeeper1-log:
  zookeeper2-data:
  zookeeper2-log:
  zookeeper3-data:
  zookeeper3-log:
  kafka1-data:
  kafka2-data:
  kafka3-data:
  journalnode1-data:
  journalnode2-data:
  journalnode3-data:
  namenode1-data:
  namenode2-data:
  datanode1-data:
  datanode2-data:
  datanode3-data:
  hdfs-zkfc-state:
  clickhouse-data:
  grafana-data:
  prometheus-data:
